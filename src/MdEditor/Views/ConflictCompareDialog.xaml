<ContentDialog
    x:Class="VibeCode.MdEditor.Views.ConflictCompareDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:VibeCode.MdEditor.Models"
    CloseButtonText="取消"
    DefaultButton="Primary"
    MaxWidth="1000"
    PrimaryButtonText="保留草稿"
    SecondaryButtonText="載入磁碟版本"
    Title="並排比較"
    mc:Ignorable="d">
    <Grid
        Width="900"
        Height="500"
        RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="HeaderText"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />

        <Grid
            Grid.Row="1"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                FontWeight="SemiBold"
                Text="草稿" />
            <TextBlock
                Grid.Column="1"
                FontWeight="SemiBold"
                Text="磁碟版本" />
        </Grid>

        <Grid Grid.Row="2">
            <ListView
                x:Name="DiffList"
                AutomationProperties.Name="並排差異清單"
                IsItemClickEnabled="False"
                SelectionMode="None"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="IsTabStop" Value="False" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DiffRowViewModel">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                VerticalAlignment="Top"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind LeftNumber}"
                                TextAlignment="Right" />
                            <Grid Grid.Column="1">
                                <Border
                                    Background="{ThemeResource DiffRemovedBackgroundBrush}"
                                    CornerRadius="2"
                                    Visibility="{x:Bind LeftRemovedVisibility}" />
                                <TextBlock
                                    Margin="6,2"
                                    FontFamily="Consolas"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind LeftText}"
                                    TextWrapping="Wrap" />
                            </Grid>

                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Top"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind RightNumber}"
                                TextAlignment="Right" />
                            <Grid Grid.Column="3">
                                <Border
                                    Background="{ThemeResource DiffAddedBackgroundBrush}"
                                    CornerRadius="2"
                                    Visibility="{x:Bind RightAddedVisibility}" />
                                <TextBlock
                                    Margin="6,2"
                                    FontFamily="Consolas"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind RightText}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid
                x:Name="ApproximatePanel"
                Visibility="Collapsed"
                RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="ApproximateNotice"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="檔案較大，改為不標示差異的並排檢視。"
                    TextWrapping="Wrap" />

                <Grid
                    Grid.Row="1"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="DraftTextBox"
                        AcceptsReturn="True"
                        AutomationProperties.Name="草稿內容"
                        FontFamily="Consolas"
                        HorizontalAlignment="Stretch"
                        IsReadOnly="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        TextWrapping="Wrap"
                        VerticalAlignment="Stretch" />
                    <TextBox
                        x:Name="DiskTextBox"
                        Grid.Column="1"
                        AcceptsReturn="True"
                        AutomationProperties.Name="磁碟版本內容"
                        FontFamily="Consolas"
                        HorizontalAlignment="Stretch"
                        IsReadOnly="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        TextWrapping="Wrap"
                        VerticalAlignment="Stretch" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentDialog>
