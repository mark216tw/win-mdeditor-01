<ContentDialog
    x:Class="VibeCode.MdEditor.Views.PreferencesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="偏好設定"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonText="儲存"
    mc:Ignorable="d">
    <ScrollViewer
        Padding="0,0,16,0"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel MinWidth="380" Spacing="20">
            <ComboBox
                x:Name="DisplayModeComboBox"
                AutomationProperties.Name="顯示模式"
                Header="顯示模式"
                HorizontalAlignment="Stretch"
                SelectionChanged="ThemeComboBox_SelectionChanged" />

            <ComboBox
                x:Name="ThemeColorComboBox"
                AutomationProperties.Name="主題顏色"
                Header="主題顏色"
                HorizontalAlignment="Stretch"
                SelectionChanged="ThemeComboBox_SelectionChanged" />

            <ComboBox
                x:Name="FontFamilyComboBox"
                AutomationProperties.Name="編輯器字型"
                Header="編輯器字型"
                HorizontalAlignment="Stretch"
                IsEditable="False" />

            <StackPanel Spacing="6">
                <ToggleSwitch
                    x:Name="SyncScrollingToggle"
                    Header="同步捲動"
                    OffContent="停用"
                    OnContent="啟用" />

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="啟用後，在並排檢視中捲動編輯器時，預覽視窗會依區塊行號自動對齊捲動位置。"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="6">
                <ToggleSwitch
                    x:Name="WordWrapToggle"
                    Header="自動換行"
                    OffContent="停用"
                    OnContent="啟用" />

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="啟用後，過長的文字會依編輯器寬度自動折行顯示，不需水平捲動；停用時則維持單行並提供水平捲動。"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ComboBox
                x:Name="FontSizeComboBox"
                Header="字型大小"
                HorizontalAlignment="Stretch" />

            <Border
                Height="1"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <StackPanel Spacing="8">
                <TextBlock
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="檔案關聯" />

                <ToggleSwitch
                    x:Name="FileAssociationToggle"
                    AutomationProperties.Name="登錄為 Markdown 檔案的開啟方式"
                    Header="登錄為 Markdown 檔案（.md、.markdown、.mdown、.mkd）的開啟方式"
                    OffContent="未登錄"
                    OnContent="已登錄" />

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="登錄後，MiniMdEditor 會出現在「開啟方式」與 Windows「預設應用程式」清單中。Windows 不允許程式自行設定預設，請在開啟的設定頁面選擇一次。"
                    TextWrapping="Wrap" />

                <Button
                    x:Name="OpenDefaultAppsButton"
                    AutomationProperties.Name="登錄並開啟 Windows 預設應用程式設定"
                    Click="OpenDefaultAppsButton_Click"
                    Content="登錄並開啟預設應用程式設定"
                    ToolTipService.ToolTip="登錄檔案關聯並開啟 Windows 預設應用程式設定" />

                <InfoBar
                    x:Name="AssociationInfoBar"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Error" />
            </StackPanel>

            <Border
                Height="1"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <StackPanel Spacing="8">
                <TextBlock
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="翻譯" />

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="使用 OpenAI 相容的 Chat Completions API 翻譯整篇文章。文件內容會傳送到你設定的端點；API Key 儲存在 Windows 認證管理員，不會寫入設定檔。"
                    TextWrapping="Wrap" />

                <TextBox
                    x:Name="TranslationEndpointTextBox"
                    AutomationProperties.Name="翻譯 API 端點"
                    Header="API 端點"
                    PlaceholderText="https://api.openai.com/v1" />

                <TextBox
                    x:Name="TranslationModelTextBox"
                    AutomationProperties.Name="翻譯模型"
                    Header="模型"
                    PlaceholderText="例如 gpt-4.1-mini" />

                <ComboBox
                    x:Name="TranslationSourceLanguageComboBox"
                    AutomationProperties.Name="翻譯來源語言"
                    Header="來源語言"
                    HorizontalAlignment="Stretch" />

                <ComboBox
                    x:Name="TranslationTargetLanguageComboBox"
                    AutomationProperties.Name="翻譯目標語言"
                    Header="目標語言"
                    HorizontalAlignment="Stretch" />

                <PasswordBox
                    x:Name="TranslationApiKeyPasswordBox"
                    AutomationProperties.Name="翻譯 API Key"
                    Header="API Key"
                    PlaceholderText="留空表示沿用已儲存的金鑰"
                    PasswordRevealMode="Peek" />

                <TextBlock
                    x:Name="TranslationApiKeyStatusText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />

                <CheckBox
                    x:Name="ClearTranslationApiKeyCheckBox"
                    AutomationProperties.Name="清除已儲存的翻譯 API Key"
                    Content="清除已儲存的 API Key" />

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="TestTranslationButton"
                        AutomationProperties.Name="測試翻譯連線"
                        Click="TestTranslationButton_Click"
                        Content="測試連線" />

                    <ProgressRing
                        x:Name="TestTranslationProgressRing"
                        Width="16"
                        Height="16"
                        IsActive="False" />
                </StackPanel>

                <InfoBar
                    x:Name="TranslationInfoBar"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Informational" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
