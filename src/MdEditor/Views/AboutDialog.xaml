<ContentDialog
    x:Class="VibeCode.MdEditor.Views.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="關於"
    CloseButtonText="關閉"
    DefaultButton="Close"
    mc:Ignorable="d">
    <StackPanel MinWidth="400" Spacing="16">
        <StackPanel Orientation="Horizontal" Spacing="14">
            <Image
                Width="64"
                Height="64"
                Source="ms-appx:///Assets/AppIcon.png" />
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="Markdown 編輯器" />
                <TextBlock
                    x:Name="VersionText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <TextBlock
            Text="Windows 上的 Markdown 編輯器，支援即時預覽、多文件分頁、PDF／Word 匯出與外部變更偵測。"
            TextWrapping="Wrap" />

        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="使用元件：WinUI 3、CodeMirror 6、Markdig、Open XML SDK、highlight.js"
            TextWrapping="Wrap" />

        <TextBlock
            FontSize="12"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Text="Copyright © VibeCode"
            TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
