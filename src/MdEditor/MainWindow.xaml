<Window
    x:Class="VibeCode.MdEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:VibeCode.MdEditor.Controls"
    xmlns:models="using:VibeCode.MdEditor.Models"
    xmlns:views="using:VibeCode.MdEditor.Views"
    mc:Ignorable="d"
    Title="Markdown 編輯器">
    <Grid
        x:Name="RootGrid"
        AllowDrop="True"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        DragOver="RootGrid_DragOver"
        Drop="RootGrid_Drop"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator
                Key="N"
                Invoked="NewAccelerator_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="O"
                Invoked="OpenAccelerator_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="S"
                Invoked="SaveAccelerator_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="S"
                Invoked="SaveAsAccelerator_Invoked"
                Modifiers="Control,Shift" />
            <KeyboardAccelerator
                Key="W"
                Invoked="CloseDocumentAccelerator_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Number1"
                Invoked="ViewEditAccelerator_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Number2"
                Invoked="ViewPreviewAccelerator_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Number3"
                Invoked="ViewSplitAccelerator_Invoked"
                Modifiers="Control" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MenuBar
            Grid.Row="0"
            Margin="4,0"
            HorizontalAlignment="Left">
            <MenuBarItem AccessKey="F" Title="檔案 (F)">
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.NewDocumentCommand}"
                    KeyboardAcceleratorTextOverride="Ctrl+N"
                    Text="新增" />
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.OpenDocumentCommand}"
                    KeyboardAcceleratorTextOverride="Ctrl+O"
                    Text="開啟..." />
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.SaveCommand}"
                    KeyboardAcceleratorTextOverride="Ctrl+S"
                    Text="儲存" />
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.SaveAsCommand}"
                    KeyboardAcceleratorTextOverride="Ctrl+Shift+S"
                    Text="另存新檔..." />
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.SaveAllCommand}"
                    Text="儲存全部" />
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Name="RecentSubMenu" Text="最近開啟" />
                <MenuFlyoutSubItem Text="匯出">
                    <MenuFlyoutItem
                        Command="{x:Bind ViewModel.ExportPdfCommand}"
                        Text="匯出 PDF..." />
                    <MenuFlyoutItem
                        Command="{x:Bind ViewModel.ExportWordCommand}"
                        Text="匯出 Word (.docx)..." />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.CloseActiveDocumentCommand}"
                    KeyboardAcceleratorTextOverride="Ctrl+W"
                    Text="關閉文件" />
                <MenuFlyoutItem Click="ExitItem_Click" Text="結束程式" />
            </MenuBarItem>
            <MenuBarItem AccessKey="E" Title="編輯 (E)">
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.EditorCommandCommand}"
                    CommandParameter="undo"
                    KeyboardAcceleratorTextOverride="Ctrl+Z"
                    Text="復原" />
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.EditorCommandCommand}"
                    CommandParameter="redo"
                    KeyboardAcceleratorTextOverride="Ctrl+Y"
                    Text="重做" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.EditorCommandCommand}"
                    CommandParameter="selectAll"
                    KeyboardAcceleratorTextOverride="Ctrl+A"
                    Text="全選" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.EditorCommandCommand}"
                    CommandParameter="find"
                    KeyboardAcceleratorTextOverride="Ctrl+F"
                    Text="尋找／取代..." />
            </MenuBarItem>
            <MenuBarItem AccessKey="V" Title="檢視 (V)">
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.SetViewModeCommand}"
                    CommandParameter="Edit"
                    KeyboardAcceleratorTextOverride="Ctrl+1"
                    Text="編輯" />
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.SetViewModeCommand}"
                    CommandParameter="Preview"
                    KeyboardAcceleratorTextOverride="Ctrl+2"
                    Text="預覽" />
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.SetViewModeCommand}"
                    CommandParameter="Split"
                    KeyboardAcceleratorTextOverride="Ctrl+3"
                    Text="並排" />
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem
                    Command="{x:Bind ViewModel.ToggleWordWrapCommand}"
                    IsChecked="{x:Bind ViewModel.WordWrapEnabled, Mode=OneWay}"
                    Text="自動換行" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.ZoomInCommand}"
                    KeyboardAcceleratorTextOverride="Ctrl++"
                    Text="放大字型" />
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.ZoomOutCommand}"
                    KeyboardAcceleratorTextOverride="Ctrl+-"
                    Text="縮小字型" />
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.ZoomResetCommand}"
                    KeyboardAcceleratorTextOverride="Ctrl+0"
                    Text="重設字型大小" />
            </MenuBarItem>
            <MenuBarItem AccessKey="S" Title="設定 (S)">
                <MenuFlyoutItem
                    Click="PreferencesItem_Click"
                    KeyboardAcceleratorTextOverride="Ctrl+,"
                    Text="偏好設定..." />
                <MenuFlyoutItem Click="AboutItem_Click" Text="關於" />
            </MenuBarItem>
        </MenuBar>

        <Grid
            Grid.Row="1"
            Padding="8,2"
            ColumnSpacing="4">
            <Grid.Resources>
                <SolidColorBrush
                    x:Key="ButtonBackgroundPointerOver"
                    Color="{ThemeResource TextFillColorPrimary}"
                    Opacity="0.12" />
                <SolidColorBrush
                    x:Key="ButtonBackgroundPressed"
                    Color="{ThemeResource TextFillColorPrimary}"
                    Opacity="0.2" />
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer
                Grid.Column="0"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        Command="{x:Bind ViewModel.FormatCommand}"
                        CommandParameter="bold"
                        Content="B"
                        FontWeight="Bold"
                        KeyboardAcceleratorPlacementMode="Hidden"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="粗體 (Ctrl+B)">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="B" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button
                        Command="{x:Bind ViewModel.FormatCommand}"
                        CommandParameter="italic"
                        Content="I"
                        FontStyle="Italic"
                        KeyboardAcceleratorPlacementMode="Hidden"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="斜體 (Ctrl+I)">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="I" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button
                        Command="{x:Bind ViewModel.FormatCommand}"
                        CommandParameter="strike"
                        Content="S"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="刪除線" />
                    <Button
                        Command="{x:Bind ViewModel.FormatCommand}"
                        CommandParameter="inlinecode"
                        Content="&lt;/&gt;"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="行內程式碼" />

                    <Border
                        Width="1"
                        Margin="4,0"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Button
                        Command="{x:Bind ViewModel.FormatCommand}"
                        CommandParameter="h1"
                        Content="H1"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="標題 1" />
                    <Button
                        Command="{x:Bind ViewModel.FormatCommand}"
                        CommandParameter="h2"
                        Content="H2"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="標題 2" />
                    <Button
                        Command="{x:Bind ViewModel.FormatCommand}"
                        CommandParameter="h3"
                        Content="H3"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="標題 3" />

                    <Border
                        Width="1"
                        Margin="4,0"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Button
                        Command="{x:Bind ViewModel.FormatCommand}"
                        CommandParameter="ul"
                        Content="清單"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="項目清單" />
                    <Button
                        Command="{x:Bind ViewModel.FormatCommand}"
                        CommandParameter="ol"
                        Content="1."
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="編號清單" />
                    <Button
                        Command="{x:Bind ViewModel.FormatCommand}"
                        CommandParameter="task"
                        Content="[ ]"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="工作清單" />
                    <Button
                        Command="{x:Bind ViewModel.FormatCommand}"
                        CommandParameter="quote"
                        Content="引用"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="引用區塊" />
                    <Button
                        Command="{x:Bind ViewModel.FormatCommand}"
                        CommandParameter="code"
                        Content="程式碼"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="程式碼區塊" />

                    <Border
                        Width="1"
                        Margin="4,0"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Button
                        Command="{x:Bind ViewModel.FormatCommand}"
                        CommandParameter="link"
                        Content="連結"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="插入連結" />
                    <Button
                        Command="{x:Bind ViewModel.FormatCommand}"
                        CommandParameter="image"
                        Content="圖片"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="插入圖片" />
                    <Button
                        Command="{x:Bind ViewModel.FormatCommand}"
                        CommandParameter="table"
                        Content="表格"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="插入表格" />
                    <Button
                        Command="{x:Bind ViewModel.FormatCommand}"
                        CommandParameter="hr"
                        Content="---"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="水平線" />
                </StackPanel>
            </ScrollViewer>

            <Border
                Grid.Column="1"
                Width="1"
                Margin="4,4"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Button
                Grid.Column="2"
                AutomationProperties.Name="切換檢視模式"
                Command="{x:Bind ViewModel.CycleViewModeCommand}"
                Style="{StaticResource ToolbarButtonStyle}"
                ToolTipService.ToolTip="{x:Bind ViewModel.ViewModeToolTip, Mode=OneWay}">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.ViewModeButtonText, Mode=OneWay}" />
            </Button>
        </Grid>

        <ListView
            x:Name="DocumentTabs"
            Grid.Row="2"
            Padding="8,4,8,0"
            HorizontalAlignment="Stretch"
            IsItemClickEnabled="False"
            ItemsSource="{x:Bind ViewModel.Documents, Mode=OneWay}"
            SelectionChanged="DocumentTabs_SelectionChanged"
            SelectionMode="Single"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="36" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,4,0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:DocumentViewModel">
                    <Border
                        Padding="12,0,6,0"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8,8,0,0"
                        PointerPressed="Tab_PointerPressed"
                        Tag="{x:Bind Id}">
                        <Border.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    Click="CloseTab_Click"
                                    Tag="{x:Bind Id}"
                                    Text="關閉" />
                                <MenuFlyoutItem
                                    Click="CloseOtherTabs_Click"
                                    Tag="{x:Bind Id}"
                                    Text="關閉其他文件" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    Click="CopyTabPath_Click"
                                    Tag="{x:Bind Id}"
                                    Text="複製完整路徑" />
                                <MenuFlyoutItem
                                    Click="RevealTabFile_Click"
                                    Tag="{x:Bind Id}"
                                    Text="在檔案總管中顯示" />
                            </MenuFlyout>
                        </Border.ContextFlyout>
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <TextBlock
                                MaxWidth="180"
                                VerticalAlignment="Center"
                                Text="{x:Bind Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="8"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Text="●"
                                Visibility="{x:Bind DirtyVisibility, Mode=OneWay}" />
                            <Button
                                Width="22"
                                Height="22"
                                Padding="0"
                                AutomationProperties.Name="關閉文件"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="CloseTab_Click"
                                Content="&#xE711;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="9"
                                Tag="{x:Bind Id}"
                                ToolTipService.ToolTip="關閉文件" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid
            Grid.Row="3"
            Margin="8,0,8,8"
            ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="EditorColumn" Width="*" MinWidth="220" />
                <ColumnDefinition x:Name="SplitterColumn" Width="6" />
                <ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <views:EditorHostView x:Name="EditorHost" Grid.Column="0" />
            <controls:SplitterHandle
                x:Name="Splitter"
                Grid.Column="1"
                Width="6"
                AutomationProperties.Name="調整編輯與預覽寬度"
                DragDelta="Splitter_DragDelta" />
            <views:PreviewHostView x:Name="PreviewHost" Grid.Column="2" />
        </Grid>

        <InfoBar
            x:Name="ExternalChangeBar"
            Grid.Row="4"
            Margin="8,0,8,4"
            AutomationProperties.Name="ExternalChangeBar"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.IsExternalChangeVisible, Mode=OneWay}"
            Message="{x:Bind ViewModel.ExternalChangeMessage, Mode=OneWay}"
            Severity="Warning"
            Title="檔案已在外部變更">
            <InfoBar.ActionButton>
                <Button
                    AutomationProperties.Name="ReloadButton"
                    Command="{x:Bind ViewModel.ReloadCommand}"
                    Content="重新載入"
                    Style="{StaticResource ToolbarButtonStyle}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <InfoBar
            x:Name="ErrorBar"
            Grid.Row="5"
            Margin="8,0,8,4"
            AutomationProperties.Name="ErrorBar"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.IsErrorVisible, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error"
            Title="發生錯誤" />

        <Border
            Grid.Row="6"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid Padding="12,6" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ProgressRing
                        Width="14"
                        Height="14"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.BusyText, Mode=OneWay}" />
                    <Button
                        Width="24"
                        Height="24"
                        Padding="0"
                        AutomationProperties.Name="在檔案總管中顯示目前檔案"
                        Click="RevealActiveFile_Click"
                        IsEnabled="{x:Bind ViewModel.HasActiveFilePath, Mode=OneWay}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.FilePathText, Mode=OneWay}">
                        <FontIcon FontSize="13" Glyph="&#xE8B7;" />
                    </Button>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="14">
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.CursorText, Mode=OneWay}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.WordCountText, Mode=OneWay}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.EncodingText, Mode=OneWay}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.LineEndingText, Mode=OneWay}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.SaveStateText, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
