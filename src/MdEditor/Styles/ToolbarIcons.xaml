    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 18x18 fixed artboard with Stretch="None" so every glyph shares identical optical scale and stroke weight -->
    <Style x:Key="ToolbarIconStyle" TargetType="Path">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Stroke" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeThickness" Value="1.5" />
    </Style>

